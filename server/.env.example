# Whisper relay — environment configuration example.
# Copy to `.env` (or /etc/whisper/relay.env on the server) and adjust.
# NEVER commit the real `.env` to the repository.

# Bind address for the relay (default: 0.0.0.0:8080)
WHISPER_ADDR=0.0.0.0:8080

# Path to the SQLite database file (default: data/relay.db)
WHISPER_DB_PATH=data/relay.db

# Per-IP rate limiting (token bucket):
#   WHISPER_RATE_BURST  = max burst of envelopes allowed at once (default 60)
#   WHISPER_RATE_REFILL = tokens refilled per second (default 1 -> ~60/min)
WHISPER_RATE_BURST=60
WHISPER_RATE_REFILL=1

# Trusted reverse proxies in front of the relay (comma/space-separated IPs).
# REQUIRED when running behind nginx/Caddy/Cloudflare: the relay only honors
# X-Forwarded-For / CF-Connecting-IP from these addresses, so per-IP rate
# limiting keys on the real client instead of the proxy. Leave empty when the
# relay is exposed directly (the safe default).
# Example (nginx/Caddy on the same host):
#   WHISPER_TRUSTED_PROXIES=127.0.0.1
# Example (Cloudflare Tunnel via cloudflared on the same host):
#   WHISPER_TRUSTED_PROXIES=127.0.0.1
# Example (remote proxy): WHISPER_TRUSTED_PROXIES=10.0.0.5
WHISPER_TRUSTED_PROXIES=

# Log level (default: info,whisper_relay=debug)
RUST_LOG=info
